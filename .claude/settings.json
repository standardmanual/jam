{
  "enabledPlugins": {
    "impeccable@impeccable": true
  },
  "permissions": {
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(xargs rm *)",
      "Bash(rm -rf /*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin staging*)",
      "Bash(git push origin claude/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git restore *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git ls-files*)",
      "Bash(git worktree *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx tsc *)",
      "Bash(npx tsx *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npx storybook *)",
      "Bash(npx supabase *)",
      "Bash(npx vercel *)",
      "Bash(node_modules/.bin/*)",
      "Bash(vercel ls *)",
      "Bash(vercel inspect *)",
      "Bash(vercel alias *)",
      "Bash(NODE_EXTRA_CA_CERTS=/tmp/system-ca.pem *)",
      "Bash(python3 *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(cmp *)",
      "Bash(diff *)",
      "Bash(mkdir -p *)",
      "Bash(chmod +x *)",
      "Bash(command -v *)",
      "Bash(security find-certificate *)",
      "Bash(curl -s -o /dev/null *)",
      "Bash(curl -sI *)",
      "Bash(curl -s http://localhost:*)",
      "WebSearch"
    ]
  }
}
