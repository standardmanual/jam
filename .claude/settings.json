{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin staging*)",
      "Bash(JAM_SHIP=1 git push origin main*)",
      "Bash(git push origin claude/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git restore *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git ls-files*)",
      "Bash(git worktree *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx tsc *)",
      "Bash(npx tsx *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npx storybook *)",
      "Bash(npx supabase *)",
      "Bash(npx vercel *)",
      "Bash(node_modules/.bin/*)",
      "Bash(vercel ls *)",
      "Bash(vercel inspect *)",
      "Bash(vercel alias *)",
      "Bash(NODE_EXTRA_CA_CERTS=/tmp/system-ca.pem *)",
      "Bash(python3 *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(cmp *)",
      "Bash(diff *)",
      "Bash(mkdir -p *)",
      "Bash(chmod +x *)",
      "Bash(command -v *)",
      "Bash(security find-certificate *)",
      "Bash(curl -s -o /dev/null *)",
      "Bash(curl -sI *)",
      "Bash(curl -s http://localhost:*)",
      "WebSearch",
      "mcp__supabase__execute_sql",
      "mcp__supabase__apply_migration"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(xargs rm *)",
      "Bash(rm -rf /*)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/ticket-dashboard.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-routine-reports.mjs\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/workspace-setup.sh\" cleanup >/dev/null 2>&1 || true",
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/ensure-hooks-path.sh\" || true"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/ensure-session-author.sh\" || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": false,
    "vercel@claude-plugins-official": true,
    "humanize-korean@im-not-ai": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "im-not-ai": {
      "source": {
        "source": "git",
        "url": "https://github.com/epoko77-ai/im-not-ai.git"
      }
    }
  },
  "outputStyle": "fluent-korean"
}
