#!/bin/bash
# review 브랜치(claude/jamwork-*)에서 티켓 status를 CLOSED로 커밋하는 것을 차단한다.
#
# 배경: jam-developer(트레일메이커)가 조사/구현을 마친 뒤 스스로 티켓을 CLOSED로 마킹하는
# 프로세스 이탈이 프롬프트 규칙만으로는 3회 반복됐다 (티켓 009, 010, 011). CLOSED 처리는
# 사용자 승인 후 오케스트레이터(베이스캠프)가 main 브랜치에서만 하도록 설계돼 있으므로,
# 프롬프트가 아니라 git 레벨에서 기계적으로 막는다.

branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

case "$branch" in
  claude/jamwork-*)
    blocked=0
    # 파일명에 공백이 있을 수 있으므로(예: "Service Plan/...") NUL 구분으로 안전하게 순회한다.
    while IFS= read -r -d '' f; do
      if git diff --cached -- "$f" | grep -qE '^\+status: CLOSED\b'; then
        echo "차단(pre-commit): review 브랜치 '${branch}'에서는 티켓 status를 CLOSED로 커밋할 수 없습니다." >&2
        echo "  파일: $f" >&2
        echo "  CLOSED 처리는 사용자 승인 후 오케스트레이터가 main 브랜치에서 직접 합니다." >&2
        echo "  완료 기록 내용은 남기되 status는 OPEN/IN_PROGRESS로 두고 closed: 필드는 비워두세요." >&2
        blocked=1
      fi
    done < <(git diff --cached --name-only -z --diff-filter=ACM -- "Service Plan/Tickets/*.md")
    if [ "$blocked" -eq 1 ]; then
      exit 1
    fi
    ;;
esac

# ─────────────────────────────────────────────────────────────────────────────
# 문서 체계 규칙을 기계적으로 강제한다 (2026-08-27 재편).
#
# 배경: 폴더 체계를 재편해도 규칙이 문서에만 있으면 시간이 지나며 무너진다. 실제로
#   - 서비스플랜이 v3.0~v4.3 사본 15개로 증식해 최신본 판별이 불가능해졌고
#   - 티켓 번호가 병렬 세션 경합으로 32건 충돌했으며
#   - 폐기 선언된 Operations 폴더의 문서가 그 뒤로도 계속 갱신됐다
# 전부 "규칙은 있었는데 아무도 막지 않은" 경우다. 여기서 기계적으로 막는다.
#
# 탈출구: 정당한 예외는 JAM_SKIP_DOCLINT=1 로 우회한다 (사유를 커밋 메시지에 남길 것).
if [ "${JAM_SKIP_DOCLINT:-0}" != "1" ]; then
  doclint=0
  CATS='Admin|Service|Feature|Content|BadgeEngine|Infra|UI|API'

  # 스테이지된 변경을 rename 탐지와 함께 '한 번에' 읽는다.
  # ⚠️ pathspec으로 걸러 읽으면 rename 쌍의 반대쪽이 diff에서 빠져 git이 이동을 판별하지
  #    못하고 '신규 추가(A)'로 보고한다. 그러면 정당한 git mv 아카이브까지 ③에 걸린다.
  # (bash 3.2는 $( ) 안의 case 패턴 ')' 를 오파싱하므로 함수로 분리한다)
  _jam_staged() {
    local st path _old
    while IFS= read -r -d '' st; do
      case "$st" in
        R*|C*)
          IFS= read -r -d '' _old
          IFS= read -r -d '' path
          ;;
        *)
          IFS= read -r -d '' path
          ;;
      esac
      printf '%s\t%s\n' "${st%%[0-9]*}" "$path"
    done < <(git diff --cached --name-status -z --find-renames)
  }
  staged=$(_jam_staged)

  while IFS="$(printf '\t')" read -r st f; do
    [ -n "$f" ] || continue

    # 티켓 폴더 공통 제외 대상
    skip_ticket=0
    case "$f" in
      "Service Plan/Tickets/Moduler/"*) skip_ticket=1 ;;
      "Service Plan/Tickets/_TEMPLATE.md"|"Service Plan/Tickets/README.md") skip_ticket=1 ;;
      "Service Plan/Tickets/"*.md) ;;
      *) skip_ticket=1 ;;
    esac

    # ① 신규 티켓 파일명: YYYYMMDD_HHMM_[카테고리8종]_제목.md
    #    기존 YYYYMMDD_NNN 티켓은 소급 개명하지 않으므로 '신규 추가'에만 적용한다.
    #    Tickets/Moduler/ 는 NNN_P{우선순위}_{동작}_ 규칙이라 대상이 아니다.
    if [ "$skip_ticket" -eq 0 ] && [ "$st" = "A" ]; then
      if ! basename "$f" | grep -qE "^[0-9]{8}_[0-9]{4}_(${CATS})_.+\.md$"; then
        echo "차단(pre-commit): 신규 티켓 파일명이 규칙에 맞지 않습니다." >&2
        echo "  파일: $f" >&2
        echo "  형식: YYYYMMDD_HHMM_[카테고리]_[제목].md  (HHMM = 생성 시각 KST)" >&2
        echo "  카테고리: ${CATS}" >&2
        doclint=1
      fi
    fi

    # ② 티켓 frontmatter status 누락 차단 (신규·수정 공통)
    if [ "$skip_ticket" -eq 0 ] && { [ "$st" = "A" ] || [ "$st" = "M" ]; } && [ -f "$f" ]; then
      if ! head -1 "$f" | grep -q '^---$' || ! head -8 "$f" | grep -qE '^status:'; then
        echo "차단(pre-commit): 티켓에 YAML frontmatter status가 없습니다." >&2
        echo "  파일: $f" >&2
        echo "  첫 줄부터 ---, 8줄 안에 'status: OPEN|IN_PROGRESS|CLOSED' 가 있어야 합니다." >&2
        echo "  템플릿: Service Plan/Tickets/_TEMPLATE.md" >&2
        doclint=1
      fi
    fi

    # ③ Archive/ 는 읽기 전용 — 신규 파일 생성만 막는다 (git mv 이동은 R이므로 통과)
    case "$f" in
      "Service Plan/Archive/"*)
        if [ "$st" = "A" ]; then
          echo "차단(pre-commit): Archive/ 는 읽기 전용 아카이브입니다 — 신규 파일을 만들 수 없습니다." >&2
          echo "  파일: $f" >&2
          echo "  현행 문서는 Specs/ 에, 작업 이력은 Tickets/ 에 남깁니다." >&2
          echo "  기존 문서를 아카이브하려면 git mv 로 '이동'하세요 (이동은 통과합니다)." >&2
          doclint=1
        fi
        ;;
    esac

    # ④ 서비스플랜 버전 사본 생성 차단 — 단일 파일 직접 수정이 원칙
    case "$f" in
      "Service Plan/Business/"*)
        if [ "$st" = "A" ] && basename "$f" | grep -qE 'v[0-9]+\.[0-9]+'; then
          echo "차단(pre-commit): 서비스플랜은 버전 사본을 만들지 않습니다." >&2
          echo "  파일: $f" >&2
          echo "  'Service Plan/Business/서비스플랜/02 JAM! 서비스 플랜.md' 를 직접 수정하세요." >&2
          echo "  버전 이력은 git 이 보관합니다 (v3.0~v4.3 사본 15개가 누적된 전례가 있습니다)." >&2
          doclint=1
        fi
        ;;
    esac
  done <<< "$staged"

  if [ "$doclint" -eq 1 ]; then
    echo "" >&2
    echo "  문서 체계 규칙: CLAUDE.md '폴더 = 수명주기' 절 참조" >&2
    echo "  정당한 예외라면 JAM_SKIP_DOCLINT=1 git commit ... 로 우회하고 사유를 남기세요." >&2
    exit 1
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# MODULAR 컴포넌트를 고쳤는데 Storybook Story를 빠뜨렸는지 확인한다 (경고 단계).
#
# 배경: Storybook은 MODULAR의 실행 가능한 카탈로그이며, Claude Code가 UI 작업 전 가장 먼저
# 탐색하는 입구다. 컴포넌트만 바뀌고 Story가 낡으면 카탈로그가 진실을 반영하지 못하고,
# 그 시점부터 "탐색 → 재사용" 선순환이 조용히 깨진다.
#
# 지금은 경고만 한다(커밋은 통과). 기존 컴포넌트-스토리 대응이 완전해지면 아래 EXIT_ON_MISSING을
# 1로 바꿔 차단으로 전환한다.
EXIT_ON_MISSING=0

changed_components=$(git diff --cached --name-only --diff-filter=ACM \
  -- 'jam-web/design-system/components/*.jsx' | grep -v '\.stories\.' || true)

if [ -n "$changed_components" ]; then
  staged_stories=$(git diff --cached --name-only --diff-filter=ACM | grep '\.stories\.' || true)
  missing=""
  while IFS= read -r comp; do
    [ -z "$comp" ] && continue
    name=$(basename "$comp" .jsx)
    # 같은 이름의 스토리가 이번 커밋에 포함됐는지 확인
    if ! echo "$staged_stories" | grep -q "/${name}\.stories\."; then
      # 저장소에 스토리 파일 자체가 없는 경우도 함께 알린다
      if find jam-web -name "${name}.stories.*" -not -path "*/node_modules/*" 2>/dev/null | grep -q .; then
        missing="${missing}  - ${name}: Story 파일은 있으나 이번 커밋에 함께 수정되지 않았습니다\n"
      else
        missing="${missing}  - ${name}: Story 파일이 아예 없습니다\n"
      fi
    fi
  done <<< "$changed_components"

  if [ -n "$missing" ]; then
    echo "" >&2
    echo "⚠️  경고(pre-commit): MODULAR 컴포넌트를 변경했는데 Storybook Story가 함께 갱신되지 않았습니다." >&2
    printf "%b" "$missing" >&2
    echo "  Storybook은 UI 재사용 탐색의 기준이므로 컴포넌트와 Story는 함께 유지해야 합니다." >&2
    echo "  → 네 층(서비스 UI·MODULAR·Storybook·claude.ai/design) 전체 점검은 '/jam-ds' 또는" >&2
    echo "    'cd jam-web && npm run ds:check' 로 합니다." >&2
    echo "  (현재는 경고만 하고 커밋은 진행합니다)" >&2
    echo "" >&2
    if [ "$EXIT_ON_MISSING" -eq 1 ]; then
      echo "차단: Story를 작성한 뒤 다시 커밋하세요." >&2
      exit 1
    fi
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# badges 테이블 조회에 deleted_at 필터가 빠졌을 가능성이 있는 신규 호출을 경고한다.
#
# 배경: `deleted_at IS NULL` 필터 누락 패턴이 004→005→007→009→015→016→017(x2)→020→021→022로
# 반복됐다(Service Plan/Tickets/20260825_022 참고). grep만으로는
# "select+JS 사후 필터" 같은 정상 패턴을 오탐할 수 있어(017 인수인계 중 실제 발생) 완전
# 차단은 하지 않고, 새로 추가된 `.from('badges')` 호출부 근처(같은 diff hunk)에 `deleted_at`
# 언급이 전혀 없을 때만 리뷰어에게 체크리스트 알림을 준다. 이력/피드성 조회처럼 의도적으로
# 필터를 넣지 않는 경우도 있으므로 통과 여부는 사람이 판단한다(경고만, 커밋은 진행).
badges_hits=""
while IFS= read -r -d '' f; do
  case "$f" in
    *.ts|*.tsx) ;;
    *) continue ;;
  esac
  # 이번 커밋에서 새로 추가된 hunk만 훑어서, +.from('badges') 라인이 있는데 같은 hunk 안에
  # deleted_at 언급이 전혀 없는 경우만 추린다.
  hunk=""
  has_badges=0
  has_deleted_at=0
  while IFS= read -r line; do
    case "$line" in
      "@@ "*)
        if [ "$has_badges" -eq 1 ] && [ "$has_deleted_at" -eq 0 ]; then
          badges_hits="${badges_hits}  - ${f}\n"
        fi
        has_badges=0
        has_deleted_at=0
        ;;
      "+"*)
        case "$line" in
          *".from('badges')"*) has_badges=1 ;;
        esac
        case "$line" in
          *"deleted_at"*) has_deleted_at=1 ;;
        esac
        ;;
    esac
  done < <(git diff --cached -U0 -- "$f")
  if [ "$has_badges" -eq 1 ] && [ "$has_deleted_at" -eq 0 ]; then
    badges_hits="${badges_hits}  - ${f}\n"
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACM -- 'jam-web/src/*.ts' 'jam-web/src/*.tsx' 'jam-web/src/**/*.ts' 'jam-web/src/**/*.tsx')

if [ -n "$badges_hits" ]; then
  echo "" >&2
  echo "⚠️  경고(pre-commit): 새로 추가된 .from('badges') 호출부 근처에 deleted_at 언급이 없습니다." >&2
  printf "%b" "$badges_hits" >&2
  echo "  노출/카운트/지급 로직이면 .is('deleted_at', null) 필터가 필요할 수 있습니다." >&2
  echo "  이력/피드성 조회거나 관리자 편집 화면처럼 의도적으로 필터를 넣지 않는 경우도 있으니" >&2
  echo "  직접 판단하세요 (Service Plan/Tickets/20260825_022 참고)." >&2
  echo "  (경고만 하고 커밋은 진행합니다)" >&2
  echo "" >&2
fi

exit 0
