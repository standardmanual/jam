#!/bin/bash
# review 브랜치(claude/jamwork-*)에서 티켓 status를 CLOSED로 커밋하는 것을 차단한다.
#
# 배경: jam-developer(트레일메이커)가 조사/구현을 마친 뒤 스스로 티켓을 CLOSED로 마킹하는
# 프로세스 이탈이 프롬프트 규칙만으로는 3회 반복됐다 (티켓 009, 010, 011). CLOSED 처리는
# 사용자 승인 후 오케스트레이터(베이스캠프)가 main 브랜치에서만 하도록 설계돼 있으므로,
# 프롬프트가 아니라 git 레벨에서 기계적으로 막는다.

branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

case "$branch" in
  claude/jamwork-*)
    blocked=0
    # 파일명에 공백이 있을 수 있으므로(예: "Service Plan/...") NUL 구분으로 안전하게 순회한다.
    while IFS= read -r -d '' f; do
      if git diff --cached -- "$f" | grep -qE '^\+status: CLOSED\b'; then
        echo "차단(pre-commit): review 브랜치 '${branch}'에서는 티켓 status를 CLOSED로 커밋할 수 없습니다." >&2
        echo "  파일: $f" >&2
        echo "  CLOSED 처리는 사용자 승인 후 오케스트레이터가 main 브랜치에서 직접 합니다." >&2
        echo "  완료 기록 내용은 남기되 status는 OPEN/IN_PROGRESS로 두고 closed: 필드는 비워두세요." >&2
        blocked=1
      fi
    done < <(git diff --cached --name-only -z --diff-filter=ACM -- "Service Plan/Tickets/*.md")
    if [ "$blocked" -eq 1 ]; then
      exit 1
    fi
    ;;
esac

# ─────────────────────────────────────────────────────────────────────────────
# MODULAR 컴포넌트를 고쳤는데 Storybook Story를 빠뜨렸는지 확인한다 (경고 단계).
#
# 배경: Storybook은 MODULAR의 실행 가능한 카탈로그이며, Claude Code가 UI 작업 전 가장 먼저
# 탐색하는 입구다. 컴포넌트만 바뀌고 Story가 낡으면 카탈로그가 진실을 반영하지 못하고,
# 그 시점부터 "탐색 → 재사용" 선순환이 조용히 깨진다.
#
# 지금은 경고만 한다(커밋은 통과). 기존 컴포넌트-스토리 대응이 완전해지면 아래 EXIT_ON_MISSING을
# 1로 바꿔 차단으로 전환한다.
EXIT_ON_MISSING=0

changed_components=$(git diff --cached --name-only --diff-filter=ACM \
  -- 'jam-web/design-system/components/*.jsx' | grep -v '\.stories\.' || true)

if [ -n "$changed_components" ]; then
  staged_stories=$(git diff --cached --name-only --diff-filter=ACM | grep '\.stories\.' || true)
  missing=""
  while IFS= read -r comp; do
    [ -z "$comp" ] && continue
    name=$(basename "$comp" .jsx)
    # 같은 이름의 스토리가 이번 커밋에 포함됐는지 확인
    if ! echo "$staged_stories" | grep -q "/${name}\.stories\."; then
      # 저장소에 스토리 파일 자체가 없는 경우도 함께 알린다
      if find jam-web -name "${name}.stories.*" -not -path "*/node_modules/*" 2>/dev/null | grep -q .; then
        missing="${missing}  - ${name}: Story 파일은 있으나 이번 커밋에 함께 수정되지 않았습니다\n"
      else
        missing="${missing}  - ${name}: Story 파일이 아예 없습니다\n"
      fi
    fi
  done <<< "$changed_components"

  if [ -n "$missing" ]; then
    echo "" >&2
    echo "⚠️  경고(pre-commit): MODULAR 컴포넌트를 변경했는데 Storybook Story가 함께 갱신되지 않았습니다." >&2
    printf "%b" "$missing" >&2
    echo "  Storybook은 UI 재사용 탐색의 기준이므로 컴포넌트와 Story는 함께 유지해야 합니다." >&2
    echo "  (현재는 경고만 하고 커밋은 진행합니다)" >&2
    echo "" >&2
    if [ "$EXIT_ON_MISSING" -eq 1 ]; then
      echo "차단: Story를 작성한 뒤 다시 커밋하세요." >&2
      exit 1
    fi
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# badges 테이블 조회에 deleted_at 필터가 빠졌을 가능성이 있는 신규 호출을 경고한다.
#
# 배경: `deleted_at IS NULL` 필터 누락 패턴이 004→005→007→009→015→016→017(x2)→020→021→022로
# 반복됐다(Service Plan/Tickets/20260825_022 참고). grep만으로는
# "select+JS 사후 필터" 같은 정상 패턴을 오탐할 수 있어(017 인수인계 중 실제 발생) 완전
# 차단은 하지 않고, 새로 추가된 `.from('badges')` 호출부 근처(같은 diff hunk)에 `deleted_at`
# 언급이 전혀 없을 때만 리뷰어에게 체크리스트 알림을 준다. 이력/피드성 조회처럼 의도적으로
# 필터를 넣지 않는 경우도 있으므로 통과 여부는 사람이 판단한다(경고만, 커밋은 진행).
badges_hits=""
while IFS= read -r -d '' f; do
  case "$f" in
    *.ts|*.tsx) ;;
    *) continue ;;
  esac
  # 이번 커밋에서 새로 추가된 hunk만 훑어서, +.from('badges') 라인이 있는데 같은 hunk 안에
  # deleted_at 언급이 전혀 없는 경우만 추린다.
  hunk=""
  has_badges=0
  has_deleted_at=0
  while IFS= read -r line; do
    case "$line" in
      "@@ "*)
        if [ "$has_badges" -eq 1 ] && [ "$has_deleted_at" -eq 0 ]; then
          badges_hits="${badges_hits}  - ${f}\n"
        fi
        has_badges=0
        has_deleted_at=0
        ;;
      "+"*)
        case "$line" in
          *".from('badges')"*) has_badges=1 ;;
        esac
        case "$line" in
          *"deleted_at"*) has_deleted_at=1 ;;
        esac
        ;;
    esac
  done < <(git diff --cached -U0 -- "$f")
  if [ "$has_badges" -eq 1 ] && [ "$has_deleted_at" -eq 0 ]; then
    badges_hits="${badges_hits}  - ${f}\n"
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACM -- 'jam-web/src/*.ts' 'jam-web/src/*.tsx' 'jam-web/src/**/*.ts' 'jam-web/src/**/*.tsx')

if [ -n "$badges_hits" ]; then
  echo "" >&2
  echo "⚠️  경고(pre-commit): 새로 추가된 .from('badges') 호출부 근처에 deleted_at 언급이 없습니다." >&2
  printf "%b" "$badges_hits" >&2
  echo "  노출/카운트/지급 로직이면 .is('deleted_at', null) 필터가 필요할 수 있습니다." >&2
  echo "  이력/피드성 조회거나 관리자 편집 화면처럼 의도적으로 필터를 넣지 않는 경우도 있으니" >&2
  echo "  직접 판단하세요 (Service Plan/Tickets/20260825_022 참고)." >&2
  echo "  (경고만 하고 커밋은 진행합니다)" >&2
  echo "" >&2
fi

exit 0
