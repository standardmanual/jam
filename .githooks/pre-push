#!/bin/bash
# main 브랜치로의 승인되지 않은 push를 차단한다.
#
# 배경: "main에 직접 push하지 않는다"는 규칙이 프롬프트에만 존재했고, 허용목록에는 git push가
# 광범위하게 열려 있어 기계적 방어가 전혀 없었다. 개발 흐름은 staging → (사용자 확인) → main이며,
# main 승격은 /jam-ship 스킬이 유일한 승인 경로다.
#
# 우회(정상 경로): JAM_SHIP=1 git push origin main
#   → /jam-ship 스킬이 사용자 확인을 거친 뒤 이 환경변수를 붙여 실행한다.

remote_ref_prefix="refs/heads/"
zero_sha="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#$remote_ref_prefix}"

  # 링크드 워크트리 판정 — staging 차단 절과 리뷰 브랜치 verify 게이트가 공유한다
  # (티켓 20260922_1755). is_wf_worktree=1이면 Workflow 에이전트 작업 공간(wf_*)이다.
  git_dir_abs="$(cd "$(git rev-parse --git-dir 2>/dev/null)" 2>/dev/null && pwd -P)"
  git_common_dir_abs="$(cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P)"
  is_linked_worktree=0
  if [ -n "$git_dir_abs" ] && [ -n "$git_common_dir_abs" ] && [ "$git_dir_abs" != "$git_common_dir_abs" ]; then
    is_linked_worktree=1
  fi
  worktree_name="$(basename "$(git rev-parse --show-toplevel 2>/dev/null)")"
  is_wf_worktree=0
  case "$worktree_name" in
    wf_*) [ "$is_linked_worktree" = "1" ] && is_wf_worktree=1 ;;
  esac

  # 끝 커밋 작성자 검사 (티켓 20260921_1231)
  #
  # 테스트가 훅 환경의 GIT_DIR를 물려받아 저장소 설정을 오염시키면 커밋이 tester <t@example.com>으로
  # 찍히고, Vercel이 "not a member of the team"으로 배포를 막는다(티켓 20260921_1116). 오류가 배포
  # 단계에서야 드러나므로 push 시점에 막는다. 검사 대상은 끝 커밋 하나이며 과거 이력은 보지 않는다.
  # 브랜치 삭제 push는 제외한다. staging·main·리뷰 브랜치 모두 대상이다.
  #
  # 우회(사유를 커밋 메시지에 남긴다): JAM_SKIP_AUTHOR_CHECK=1 git push ...
  if [ "$local_sha" != "$zero_sha" ]; then
    if [ "${JAM_SKIP_AUTHOR_CHECK:-}" = "1" ]; then
      echo "pre-push: JAM_SKIP_AUTHOR_CHECK=1 — 끝 커밋 작성자 검사를 건너뜁니다." >&2
    else
      tip_emails="$(git log -1 --format='%ae %ce' "$local_sha" 2>/dev/null)"
      for tip_email in $tip_emails; do
        case "$tip_email" in
          *@example.com)
            echo "" >&2
            echo "차단(pre-push): 끝 커밋의 작성자 또는 커미터가 테스트 계정($tip_email)입니다." >&2
            echo "" >&2
            echo "  이 이메일로 push하면 Vercel이 팀 멤버가 아니라며 배포를 막습니다." >&2
            echo "  원인: 테스트가 실제 저장소의 git 설정을 오염시켰을 수 있습니다(티켓 20260921_1116)." >&2
            echo "  확인: git config user.email && git config core.bare" >&2
            echo "  해결: git config user.email <본인 이메일>로 바로잡은 뒤" >&2
            echo "        git commit --amend --reset-author --no-edit (끝 커밋만 다시 쓴다)" >&2
            echo "  검사를 건너뛰려면: JAM_SKIP_AUTHOR_CHECK=1 git push ... (사유를 커밋 메시지에 남긴다)" >&2
            echo "" >&2
            exit 1
            ;;
        esac
      done
    fi
  fi

  if [ "$branch" = "main" ]; then
    if [ "${JAM_SHIP:-}" = "1" ]; then
      echo "승인된 배포 경로(/jam-ship)로 main에 push합니다." >&2
      continue
    fi

    echo "" >&2
    echo "차단(pre-push): main 브랜치에 직접 push할 수 없습니다." >&2
    echo "" >&2
    echo "  JAM! 개발 흐름:" >&2
    echo "    1. staging 브랜치에서 개발하고 push" >&2
    echo "    2. 스테이징 도메인(stage.j-a-m.app)에서 확인" >&2
    echo "    3. 문제없으면 /jam-ship 으로 프로덕션 배포" >&2
    echo "" >&2
    echo "  프로덕션에 반영하려면 사용자에게 '배포해줘'라고 요청받은 뒤 /jam-ship 을 사용하세요." >&2
    echo "" >&2
    # 예약 루틴 구제 안내 (티켓 20260920_1933).
    #   루틴 프롬프트는 저장소 밖에 있어 2026-09-20 재통합 때 함께 고쳐지지 못했고, 아직
    #   'git -C jam-doc push origin main'을 담고 있다. 문서 폴더에 .git이 없으므로 그 명령은
    #   여기(jam의 main)로 온다. 문서 폴더는 2026-10-10부터 docs/ 하나다(티켓 20261010_1214).
    #   루틴이 이 메시지를 읽고 스스로 고쳐 잡을 수 있게 안내한다.
    echo "  ── 예약 루틴이라면 ──" >&2
    echo "  'git -C jam-doc push origin main'으로 여기 도달했다면, 그 명령은 2026-09-20" >&2
    echo "  저장소 재통합(티켓 20260920_1412) 이전의 낡은 지시입니다. 문서는 이제 이" >&2
    echo "  저장소의 docs/ 폴더이므로 'git -C jam-doc' 접두사 없이 다음을 실행하세요:" >&2
    echo "" >&2
    echo "    git add <리포트 파일> && git commit -m \"...\" && git push origin staging" >&2
    echo "" >&2
    echo "  자세한 대응표: .claude/skills/jam-work/references/scheduled-jobs.md 「공통 원칙」 첫 절" >&2
    echo "" >&2
    exit 1
  fi

  # 기준 방어(guard the bar) — 이번 push 범위의 diff에서 검사 기준을 낮추는 변경을 막는다.
  #
  # constraint-driven-development §Step 6(guard the bar)을 포팅했다(티켓 20260921_2304). 새
  # eslint-disable·@ts-ignore·@ts-expect-error(사유 주석 없이), it.skip·describe.skip·it.only·
  # describe.only·test.only 추가, *.test.* 파일 삭제(커밋 메시지에 "테스트 삭제: <사유>" 줄이
  # 없을 때), jam-web/package.json의 --max-warnings 상향을 막는다. main은 위에서 이미 처리돼
  # 여기로 오지 않으므로, 이 아래로 오는 모든 브랜치(staging·claude/jamwork-*·기타)에 적용된다.
  # 억제 주석·skip·only 검사는 jam-web의 실제 lint·타입체크 대상(ts·tsx·js·jsx·mjs·cjs)만 본다 —
  # 이 훅·문서·contract.json 자신이 이 단어들을 설명하며 자기 자신을 오탐하는 것을 막기 위해서다.
  #
  # 우회 변수는 두지 않는다. 정당한 예외는 diff 안의 사유 주석(예: -- 사유) 또는 커밋 메시지의
  # "테스트 삭제: <사유>" 줄로만 통과한다.
  if [ "$local_sha" != "$zero_sha" ]; then
    if [ "$remote_sha" != "$zero_sha" ]; then
      guard_base="$remote_sha"
    else
      git fetch origin staging --quiet 2>/dev/null || true
      guard_base="$(git merge-base "$local_sha" origin/staging 2>/dev/null)"
    fi

    if [ -z "$guard_base" ]; then
      echo "pre-push: 기준 방어 검사의 비교 기준을 찾지 못해 건너뜁니다 ($branch)." >&2
    else
      # 파일 경계(+++ 헤더)는 헤더 구간에서만 읽는다(티켓 20260922_0206). `diff --git` 줄에서 헤더
      # 구간이 시작되고 첫 `@@` 줄에서 끝난다. hunk 안의 줄은 ' '·'+'·'-'·'\' 접두어로 시작하므로
      # `diff --git`·`@@`로 시작할 수 없다. 내용이 "++ "로 시작하는 추가 줄이 diff에서 "+++ "로
      # 보여도 hunk 안이라 파일 헤더로 오인되지 않는다.
      added_with_path="$(git -c core.quotePath=false -c color.ui=never diff --no-color --unified=0 "$guard_base" "$local_sha" 2>/dev/null | awk '
        /^diff --git / { in_hunk = 0; f = ""; next }
        /^@@ /         { in_hunk = 1; next }
        !in_hunk && /^\+\+\+ / { f = substr($0, 5); sub(/^b\//, "", f); next }
        /^\+/          { print f "\t" substr($0, 2) }
      ')"
      js_ts_added="$(printf '%s\n' "$added_with_path" | awk -F'\t' '$1 ~ /^jam-web\/.*\.(ts|tsx|js|jsx|mjs|cjs)$/ { print substr($0, length($1) + 2) }')"

      suppression_hits="$(printf '%s\n' "$js_ts_added" | grep -E '@ts-ignore|@ts-expect-error|eslint-disable' | grep -Ev -- '-- [^[:space:]]')"
      if [ -n "$suppression_hits" ]; then
        echo "" >&2
        echo "차단(pre-push): 새 억제 주석에 사유가 없습니다 (eslint-disable·@ts-ignore·@ts-expect-error)." >&2
        echo "" >&2
        echo "$suppression_hits" | sed 's/^/    /' >&2
        echo "" >&2
        echo "  같은 줄에 \"-- 사유\" 형식으로 이유를 남기세요 (예: // eslint-disable-next-line 규칙 -- 사유)." >&2
        echo "" >&2
        exit 1
      fi

      skip_only_hits="$(printf '%s\n' "$js_ts_added" | grep -E 'it\.skip\(|describe\.skip\(|it\.only\(|describe\.only\(|test\.only\(')"
      if [ -n "$skip_only_hits" ]; then
        echo "" >&2
        echo "차단(pre-push): 테스트를 건너뛰거나 하나만 실행하게 만든 코드가 추가됐습니다 (.skip·.only)." >&2
        echo "" >&2
        echo "$skip_only_hits" | sed 's/^/    /' >&2
        echo "" >&2
        exit 1
      fi

      deleted_test_files="$(git -c core.quotePath=false -c color.ui=never diff --no-color --name-status --find-renames "$guard_base" "$local_sha" 2>/dev/null | awk '$1 == "D" && $2 ~ /\.test\./ { print $2 }')"
      if [ -n "$deleted_test_files" ]; then
        commit_msgs="$(git log --format=%B "$guard_base".."$local_sha" 2>/dev/null)"
        if ! printf '%s\n' "$commit_msgs" | grep -qE '^테스트 삭제: .+'; then
          echo "" >&2
          echo "차단(pre-push): 테스트 파일이 삭제됐습니다." >&2
          echo "" >&2
          echo "$deleted_test_files" | sed 's/^/    /' >&2
          echo "" >&2
          echo "  삭제가 정당하면 커밋 메시지에 \"테스트 삭제: <사유>\" 줄을 남기세요." >&2
          echo "" >&2
          exit 1
        fi
      fi

      old_max_warnings="$(git show "$guard_base:jam-web/package.json" 2>/dev/null | grep -oE -- '--max-warnings [0-9]+' | head -1 | grep -oE '[0-9]+')"
      new_max_warnings="$(git show "$local_sha:jam-web/package.json" 2>/dev/null | grep -oE -- '--max-warnings [0-9]+' | head -1 | grep -oE '[0-9]+')"
      if [ -n "$old_max_warnings" ] && [ -n "$new_max_warnings" ] && [ "$new_max_warnings" -gt "$old_max_warnings" ]; then
        echo "" >&2
        echo "차단(pre-push): jam-web/package.json의 --max-warnings 값을 높였습니다 ($old_max_warnings → $new_max_warnings)." >&2
        echo "" >&2
        echo "  경고 상한은 낮추는 방향으로만 바꿉니다 (docs/agents/contract.json의 quality_bar.lint_max_warnings)." >&2
        echo "" >&2
        exit 1
      fi
    fi
  fi

  # 워크트리 차단 — staging으로 가는 push 중 에이전트 작업 공간에서 온 것을 막는다.
  #
  # 아현의 staging push 금지는 프롬프트 규칙뿐이었다(20260921_2207 #4). 사용자 결정
  # (2026-09-22, 티켓 20260921_2304)으로 다음 중 하나면 막는다 — 우회 변수는 두지 않는다.
  #   (a) 현재 위치가 링크드 워크트리이고 폴더 이름이 wf_로 시작(Workflow 에이전트 작업 공간)
  #   (b) push하는 로컬 브랜치가 claude/jamwork-*(아현의 리뷰 브랜치). git push origin
  #       HEAD:staging처럼 local_ref가 HEAD로 들어와도 현재 브랜치 이름으로 판정한다.
  # 카리나의 수동 격리 워크트리(handling-rules.md 17행)는 이 이름 규칙을 쓰지 않으므로 걸리지
  # 않는다. is_wf_worktree·worktree_name은 루프 상단에서 계산해 verify 게이트와 공유한다.
  if [ "$branch" = "staging" ] && [ "$local_sha" != "$zero_sha" ]; then
    case "$local_ref" in
      refs/heads/*) local_branch="${local_ref#refs/heads/}" ;;
      *) local_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" ;;
    esac

    block_reason=""
    [ "$is_wf_worktree" = "1" ] && block_reason="에이전트 작업 워크트리($worktree_name)"
    if [ -z "$block_reason" ]; then
      case "$local_branch" in
        claude/jamwork-*) block_reason="리뷰 브랜치($local_branch)" ;;
      esac
    fi

    if [ -n "$block_reason" ]; then
      echo "" >&2
      echo "차단(pre-push): ${block_reason}에서 staging으로 바로 push할 수 없습니다." >&2
      echo "" >&2
      echo "  아현의 리뷰 브랜치와 Workflow 에이전트 작업 공간은 staging에 직접 push하지 않습니다." >&2
      echo "  카리나가 메인 트리에서 review 브랜치를 staging에 merge한 뒤 push하세요" >&2
      echo "  (.claude/skills/jam-work/SKILL.md 4단계)." >&2
      echo "" >&2
      exit 1
    fi
  fi

  # staging push 시 jam-web 전체 lint를 게이트로 돌린다.
  #
  # 배경: 2026-08-27 이전까지 CI 워크플로우도, 훅도, 리뷰어 규칙도 lint를 보지 않았다.
  # Next 16은 next build에서 ESLint를 돌리지 않으므로 Vercel 빌드도 회귀를 못 잡는다.
  # 그 결과 에러가 183건까지 쌓였고, 전체가 레드라 신규 위반이 묻혀 각 티켓이 "변경 파일만
  # eslint" 우회 검증을 하게 됐다(티켓 20260827_022).
  #
  # pre-commit이 아니라 pre-push인 이유: 커밋 단위로 돌리면 느려서 결국 같은 우회 유혹이
  # 생긴다. 경고 상한(--max-warnings 26)은 현재 기준선이며 줄이는 방향으로만 갱신한다.
  #
  # jam-web을 건드리지 않은 push(문서·티켓·.claude/ 등)는 린트가 실패할 수 없으므로 건너뛴다
  # (2026-09-08, jam-work 최적화 검토) — 새 브랜치를 처음 push할 때(remote_sha가 전부 0)는
  # 비교 기준이 없으므로 안전하게 실행한다.
  #
  # 우회(예: 린트와 무관한 긴급 문서 push): JAM_SKIP_LINT=1 git push origin staging
  if [ "$branch" = "staging" ] && [ "${JAM_SKIP_LINT:-}" != "1" ]; then
    if [ "$remote_sha" != "$zero_sha" ] && ! git diff --quiet "$remote_sha" "$local_sha" -- jam-web; then
      jam_web_changed=1
    elif [ "$remote_sha" = "$zero_sha" ]; then
      jam_web_changed=1
    else
      jam_web_changed=0
    fi

    if [ "$jam_web_changed" = "1" ]; then
      hook_dir="$(git rev-parse --show-toplevel)/jam-web"
      if [ -d "$hook_dir/node_modules" ]; then
        echo "pre-push: jam-web 전체 lint 실행 중..." >&2
        if ! (cd "$hook_dir" && npm run lint:ci >/dev/null 2>&1); then
          echo "" >&2
          echo "차단(pre-push): jam-web lint가 실패했습니다." >&2
          echo "" >&2
          echo "  확인: cd jam-web && npm run lint:ci" >&2
          echo "  에러 0건 · 경고 26건 이하가 기준선입니다(티켓 20260827_022)." >&2
          echo "  린트와 무관한 긴급 push라면: JAM_SKIP_LINT=1 git push origin staging" >&2
          echo "" >&2
          exit 1
        fi
      else
        echo "pre-push: jam-web/node_modules가 없어 lint 게이트를 건너뜁니다." >&2
      fi
    else
      echo "pre-push: jam-web 변경 없음 — lint 게이트를 건너뜁니다." >&2
    fi
  fi

  # 리뷰 브랜치(claude/jamwork-*) push 시 verify 게이트 (티켓 20260918_0421)
  #
  # lint·typecheck·test·ds:check·슬롭검사를 한 번에 묶어 실행한다(scripts/verify.sh).
  # Workflow 에이전트 워크트리(wf_*)에서는 아현 로컬 → 여기(pre-push) → CI 세 번 도는 것을
  # 줄이기 위해 여기서는 건너뛰고 CI(verify 워크플로)가 검증한다(티켓 20260922_1755). 기준
  # 방어 검사(위 블록, eslint-disable 사유·skip/only·테스트 삭제 사유·max-warnings)는 모든
  # 브랜치에 그대로 적용되므로 건드리지 않는다.
  # node_modules가 없는 워크트리(막 만든 직후 등)에서는 건너뛴다 —
  # scripts/workspace-setup.sh link로 연결한 뒤 다시 push하면 게이트가 걸린다.
  #
  # 브랜치 삭제 push(local_sha가 전부 0)는 검증할 코드가 없으므로 이 게이트를 건너뛴다
  # (티켓 20261014_1442) — 삭제 ref마다 전체 검증이 돌아 병합된 리뷰 브랜치 정리가 불가능했다.
  #
  # 우회(예: verify와 무관한 긴급 push): JAM_SKIP_VERIFY=1 git push origin claude/...
  case "$branch" in
    claude/jamwork-*)
      repo_root="$(git rev-parse --show-toplevel)"
      if [ "$local_sha" = "$zero_sha" ]; then
        echo "pre-push: 브랜치 삭제 push — 검증할 코드가 없어 verify 게이트를 건너뜁니다." >&2
      elif [ "${JAM_SKIP_VERIFY:-}" = "1" ]; then
        echo "pre-push: JAM_SKIP_VERIFY=1 — verify 게이트를 건너뜁니다." >&2
      elif [ "$is_wf_worktree" = "1" ]; then
        echo "pre-push: Workflow 에이전트 워크트리($worktree_name) — CI(verify 워크플로)가 검증합니다." >&2
      elif [ -d "$repo_root/jam-web/node_modules" ]; then
        echo "pre-push: verify 실행 중 (리뷰 브랜치 $branch)..." >&2
        if ! "$repo_root/scripts/verify.sh"; then
          echo "" >&2
          echo "차단(pre-push): verify가 실패했습니다. 위 실패 항목을 확인하세요." >&2
          echo "  긴급 우회: JAM_SKIP_VERIFY=1 git push origin $branch" >&2
          exit 1
        fi
      else
        echo "pre-push: jam-web/node_modules가 없어 verify 게이트를 건너뜁니다." >&2
      fi
      ;;
  esac
done

exit 0
