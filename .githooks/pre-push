#!/bin/bash
# main 브랜치로의 승인되지 않은 push를 차단한다.
#
# 배경: "main에 직접 push하지 않는다"는 규칙이 프롬프트에만 존재했고, 허용목록에는 git push가
# 광범위하게 열려 있어 기계적 방어가 전혀 없었다. 개발 흐름은 staging → (사용자 확인) → main이며,
# main 승격은 /jam-ship 스킬이 유일한 승인 경로다.
#
# 우회(정상 경로): JAM_SHIP=1 git push origin main
#   → /jam-ship 스킬이 사용자 확인을 거친 뒤 이 환경변수를 붙여 실행한다.

remote_ref_prefix="refs/heads/"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  branch="${remote_ref#$remote_ref_prefix}"

  if [ "$branch" = "main" ]; then
    if [ "${JAM_SHIP:-}" = "1" ]; then
      echo "승인된 배포 경로(/jam-ship)로 main에 push합니다." >&2
      continue
    fi

    echo "" >&2
    echo "차단(pre-push): main 브랜치에 직접 push할 수 없습니다." >&2
    echo "" >&2
    echo "  JAM! 개발 흐름:" >&2
    echo "    1. staging 브랜치에서 개발하고 push" >&2
    echo "    2. 스테이징 도메인(jam-stage.vercel.app)에서 확인" >&2
    echo "    3. 문제없으면 /jam-ship 으로 프로덕션 배포" >&2
    echo "" >&2
    echo "  프로덕션에 반영하려면 사용자에게 '배포해줘'라고 요청받은 뒤 /jam-ship 을 사용하세요." >&2
    echo "" >&2
    exit 1
  fi

  # staging push 시 jam-web 전체 lint를 게이트로 돌린다.
  #
  # 배경: 2026-08-27 이전까지 CI 워크플로우도, 훅도, 리뷰어 규칙도 lint를 보지 않았다.
  # Next 16은 next build에서 ESLint를 돌리지 않으므로 Vercel 빌드도 회귀를 못 잡는다.
  # 그 결과 에러가 183건까지 쌓였고, 전체가 레드라 신규 위반이 묻혀 각 티켓이 "변경 파일만
  # eslint" 우회 검증을 하게 됐다(티켓 20260827_022).
  #
  # pre-commit이 아니라 pre-push인 이유: 커밋 단위로 돌리면 느려서 결국 같은 우회 유혹이
  # 생긴다. 경고 상한(--max-warnings 26)은 현재 기준선이며 줄이는 방향으로만 갱신한다.
  #
  # 우회(예: 린트와 무관한 긴급 문서 push): JAM_SKIP_LINT=1 git push origin staging
  if [ "$branch" = "staging" ] && [ "${JAM_SKIP_LINT:-}" != "1" ]; then
    hook_dir="$(git rev-parse --show-toplevel)/jam-web"
    if [ -d "$hook_dir/node_modules" ]; then
      echo "pre-push: jam-web 전체 lint 실행 중..." >&2
      if ! (cd "$hook_dir" && npm run lint:ci >/dev/null 2>&1); then
        echo "" >&2
        echo "차단(pre-push): jam-web lint가 실패했습니다." >&2
        echo "" >&2
        echo "  확인: cd jam-web && npm run lint:ci" >&2
        echo "  에러 0건 · 경고 26건 이하가 기준선입니다(티켓 20260827_022)." >&2
        echo "  린트와 무관한 긴급 push라면: JAM_SKIP_LINT=1 git push origin staging" >&2
        echo "" >&2
        exit 1
      fi
    else
      echo "pre-push: jam-web/node_modules가 없어 lint 게이트를 건너뜁니다." >&2
    fi
  fi
done

exit 0
