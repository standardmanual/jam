# JAM! 환경변수 템플릿 — 실제 값은 .env.local에 설정 (.gitignore로 커밋 제외됨)
# Vercel 배포 시 대시보드 Settings > Environment Variables에도 동일하게 등록 필요

# ── 서비스 URL ──────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://j-a-m.app

# ── Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service_role key>   # 서버 전용 — 클라이언트 노출 금지
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>  # 신규 키 체계 — 현재 인프라 레벨 사용
SUPABASE_SECRET_KEY=<sb_secret_...>            # 신규 키 체계 — 현재 인프라 레벨 사용

# ── Strava OAuth ─────────────────────────────────────────────────
STRAVA_CLIENT_ID=<숫자 ID>
STRAVA_CLIENT_SECRET=<Client Secret>            # strava.com/settings/api 에서 발급/재발급

# ── 데이터 암호화 ────────────────────────────────────────────────
ENCRYPTION_KEY=<hex 64자>  # openssl rand -hex 32

# ── 어드민 인증 ──────────────────────────────────────────────────
ADMIN_EMAILS=<email1@example.com,email2@example.com>  # 쉼표 구분
ADMIN_SECRET=<임의 비밀번호>

# ── Vercel Cron 인증 ─────────────────────────────────────────────
CRON_SECRET=<임의 문자열>

# ── 네이버 지도 (NCP) ─────────────────────────────────────────────
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=<NCP 앱 Client ID>
NEXT_PUBLIC_NAVER_MAP_STYLE_ID=<커스텀 스타일 ID>   # 선택
NCP_MAP_CLIENT_SECRET=<NCP 앱 Client Secret>

# ── 네이버 지역검색 오픈API (T2 POI 소스) ────────────────────────
NAVER_LOCAL_SEARCH_CLIENT_ID=<developers.naver.com 앱 ID>
NAVER_LOCAL_SEARCH_CLIENT_SECRET=<developers.naver.com 앱 Secret>

# ── 산림청 OpenAPI (POI 임포트 스크립트 전용) ─────────────────────
FOREST_SERVICE_KEY=<data.go.kr 인증키>

# ── Recraft API (배지 이미지 대량 생성 스크립트 전용) ───────────────
RECRAFT_API_KEY=<app.recraft.ai/profile/api 에서 발급>  # 유닛 잔액 0 초과 시에만 발급 가능

# ── Google Sheets (VOC CS 게시판, 서비스 계정 — 티켓 20260828_1921) ──────
# Google Cloud 콘솔에서 서비스 계정 생성 → 키(JSON) 발급 → 대상 스프레드시트를
# 서비스 계정 이메일에 "뷰어"로 공유해야 한다.
GOOGLE_SHEETS_CLIENT_EMAIL=<서비스 계정 이메일>@<project-id>.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
